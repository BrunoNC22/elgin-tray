# Normaliza quebras de linha para LF em todos os sistemas
* text=auto eol=lf

# Scripts do Windows precisam de CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binários
*.png binary
*.ico binary
# Chave pública de verificação das atualizações (32 bytes, embutida no app)
*.pub binary
*.svg text
